{
  "name": "agent-os",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.2.4"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "probe:cli": "bun src/probe-cli.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/bun": "latest",
    "commitlint": "^21.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.72.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write ."
    ]
  }
}
